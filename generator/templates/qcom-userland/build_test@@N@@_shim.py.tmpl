import base64
import pathlib
import struct
import subprocess
import sys
import time

port = pathlib.Path(sys.argv[1]).resolve(strict=True)
build = port / 'build'
build.mkdir(exist_ok=True)
loader = (build / '@@PREFIX@@-test@@N@@-loader.efi').read_bytes()
def item(name, data):
    return struct.pack('<16sII', name.encode(), len(data), 0) + data + bytes(-len(data) % 16)

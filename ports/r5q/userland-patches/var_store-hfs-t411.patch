+/*
+ * /private/var on the flash volume (init: var_hfs=1, an HFS+ volume on /dev/ufs_var) keeps itself: there is
+ * nothing to archive, and an archive of it would not fit a slot. At the end of a run the volume is synced instead,
+ * and the kernel is answered as for a save. statfs64(2) by hand: libmini has no statfs.
+ */
+static int
+var_is_on_flash(void)
+{
+	static unsigned char st[2168];
+
+	if (mini_syscall(345 /* SYS_statfs64 */, (long)"/private/var", (long)st, 0, 0, 0, 0) != 0) {
+		return 0;
+	}
+	return memcmp(st + 72, "hfs", 4) == 0;
+}

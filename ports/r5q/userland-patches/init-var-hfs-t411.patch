+/*
+ * /private/var on the phone's flash (var_hfs=1, kernel t410+ with ufs_var=1; wifi/STORAGE-PLAN.md): an HFS+
+ * volume on /dev/ufs_var, darwin from 16 GiB to its end (~100 GB), in place of the 1.6 GB memory filesystem.
+ * It keeps everything itself, so the skeleton only adds what is missing, and var_store's archive is loaded once,
+ * on the first boot that has the volume, to carry the memory filesystem's last state across.
+ */
+struct hfs_mount_args {
+	char *fspec;
+	unsigned int hfs_uid, hfs_gid;
+	unsigned short hfs_mask;
+	unsigned int hfs_encoding;
+	struct { int tz_minuteswest, tz_dsttime; } hfs_timezone;
+	int flags, journal_tbuffer_size, journal_flags, journal_disable;
+};
+#define VAR_SEEDED "/private/var/.redwood-var-seeded"
+static int var_on_flash;
+
+static void
+sync_volumes(void)
+{
+	(void)mini_syscall(36 /* SYS_sync */, 0, 0, 0, 0, 0, 0);
+}

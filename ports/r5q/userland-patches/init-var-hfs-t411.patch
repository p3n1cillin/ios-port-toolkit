+/*
+ * A directory and everything in it removed (on the flash volume /private/var outlives the boot, so what an
+ * earlier boot's checks left in /tmp/t is still there, and the checks expect to make it new).
+ */
+static void
+remove_tree(const char *dir, int depth)
+{
+	static char buf[8][4096];
+	char *b = buf[depth < 8 ? depth : 7];
+	off_t position = 0;
+	ssize_t n;
+	int fd = depth < 8 ? open(dir, O_RDONLY | O_DIRECTORY, 0) : -1;
+
+	if (fd >= 0) {
+		while ((n = getdirentries(fd, b, 4096, &position)) > 0) {
+			for (ssize_t at = 0; at < n; at += ((struct dirent *)(b + at))->d_reclen) {
+				const char *name = ((struct dirent *)(b + at))->d_name;
+				char full[1024];
+				struct stat st;
+
+				if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0 || strlen(dir) + strlen(name) + 2 > sizeof(full)) {
+					continue;
+				}
+				strcpy(full, dir);
+				strcpy(full + strlen(full), "/");
+				strcpy(full + strlen(full), name);
+				if (lstat(full, &st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR) {
+					remove_tree(full, depth + 1);
+				} else {
+					unlink(full);
+				}
+			}
+		}
+		close(fd);
+	}
+	rmdir(dir);
+}

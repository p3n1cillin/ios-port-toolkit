+/* Preserve the user's completed ReplayKit recording as a standalone DCIM file
+ * before the normal Photos export can move its source. Photos owns its catalogue. */
+#include <sys/stat.h>
+
+static IMP orig_rp_export_photos;
+
+static void
+r5q_copy_mp4_to_dcim(id video_url)
+{
+	static const char directory[] = "/private/var/mobile/Media/DCIM/100APPLE";
+	char staging[] = "/private/var/mobile/Media/DCIM/100APPLE/.r5q-replay-XXXXXX";
+	struct stat info;
+	uint8_t buffer[32768];
+	const char *source;
+	int input, output;
+	bool complete = false;
+
+	if (video_url == nil) {
+		return;
+	}
+	id path = ((id (*)(id, SEL))objc_msgSend)(video_url, sel_registerName("path"));
+	source = path == nil ? NULL : ((const char *(*)(id, SEL))objc_msgSend)(path, sel_registerName("UTF8String"));
+	if (source == NULL) {
+		return;
+	}
+	input = open(source, O_RDONLY | O_NOFOLLOW | O_NONBLOCK);
+	if (input < 0) {
+		return;
+	}
+	if (fstat(input, &info) != 0 || !S_ISREG(info.st_mode) || info.st_size <= 0) {
+		close(input);
+		return;
+	}
+	(void)mkdir("/private/var/mobile/Media/DCIM", 0755);
+	(void)mkdir(directory, 0755);
+	output = mkstemp(staging);
+	if (output < 0) {
+		close(input);
+		return;
+	}
+
+	off_t remaining = info.st_size;
+	while (remaining > 0) {
+		size_t want = remaining < (off_t)sizeof(buffer) ? (size_t)remaining : sizeof(buffer);
+		ssize_t count = read(input, buffer, want);
+		if (count < 0 && errno == EINTR) {
+			continue;
+		}
+		if (count <= 0) {
+			break;
+		}
+		ssize_t offset = 0;
+		while (offset < count) {
+			ssize_t written = write(output, buffer + offset, (size_t)(count - offset));
+			if (written < 0 && errno == EINTR) {
+				continue;
+			}
+			if (written <= 0) {
+				goto finish;
+			}
+			offset += written;
+		}
+		remaining -= count;
+	}
+	complete = remaining == 0;
+finish:
+	close(input);
+	if (complete) {
+		(void)fchown(output, 501, 501);
+		complete = fsync(output) == 0;
+	}
+	if (close(output) != 0) {
+		complete = false;
+	}
+	if (complete) {
+		/* Publish a complete file atomically. link() never replaces an existing asset. */
+		const char *leaf = strrchr(staging, '/');
+		char destination[128];
+		snprintf(destination, sizeof(destination), "%s/R5Q_Replay_%s.MP4", directory, leaf + sizeof("/.r5q-replay-") - 1);
+		if (link(staging, destination) == 0) {
+			say("redwood: replayd: saved standalone screen recording (%lld bytes)\n", (long long)info.st_size);
+		}
+	}
+	(void)unlink(staging);
+}
+
+static void
+my_rp_export_photos(id self, SEL _cmd, id video_url, id handler)
+{
+	r5q_copy_mp4_to_dcim(video_url);
+	((void (*)(id, SEL, id, id))orig_rp_export_photos)(self, _cmd, video_url, handler);
+}
+
+static void
+r5q_hook_replayd_photos(void)
+{
+	Class cls = objc_getClass("RPPhotosUtility");
+	Method m = cls != Nil ? class_getClassMethod(cls, sel_registerName("exportVideoToPhotosLibrary:completionHandler:")) : NULL;
+	if (m != NULL) {
+		orig_rp_export_photos = method_setImplementation(m, (IMP)my_rp_export_photos);
+		say("redwood: replayd: hooked +[RPPhotosUtility exportVideoToPhotosLibrary:completionHandler:]\n");
+	}
+}
